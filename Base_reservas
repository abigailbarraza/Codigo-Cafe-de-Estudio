@app.route("/reservar", methods=["POST"])
def reservar():
    data = request.json
    user_id = data.get("user_id")
    tipo = data.get("tipo")
    personas = data.get("personas")
    fecha = data.get("fecha")
    hora = data.get("hora")

    if not user_id:
        return jsonify({"status": "error", "message": "Usuario no autenticado"}), 401

    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("""
        INSERT INTO reservas (user_id, tipo, personas, fecha, hora)
        VALUES (?, ?, ?, ?, ?)
    """, (user_id, tipo, personas, fecha, hora))
    conn.commit()
    conn.close()

    return jsonify({"status": "success", "message": "Reserva guardada con éxito"})
