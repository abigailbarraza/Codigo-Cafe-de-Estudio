@app.route("/mis_reservas/<int:user_id>", methods=["GET"])
def mis_reservas(user_id):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("""
        SELECT id, tipo, personas, fecha, hora
        FROM reservas WHERE user_id = ?
        ORDER BY fecha, hora
    """, (user_id,))
    reservas = cursor.fetchall()
    conn.close()

    reservas_json = [
        {"id": r[0], "tipo": r[1], "personas": r[2], "fecha": r[3], "hora": r[4]}
        for r in reservas
    ]

    return jsonify({"status": "success", "reservas": reservas_json})
