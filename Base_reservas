document.getElementById("formReserva").addEventListener("submit", async function(e) {
  e.preventDefault();

  const session = JSON.parse(localStorage.getItem("session"));
  if (!session) {
    alert("Debes iniciar sesión para reservar.");
    return;
  }

  const tipo = document.getElementById("tipoReserva").value;
  const personas = document.getElementById("personas").value;
  const fecha = document.getElementById("fechaReserva").value;
  const hora = document.getElementById("horaReserva").value;

  const res = await fetch("http://127.0.0.1:5000/reservar", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({
      user_id: session.id,
      tipo,
      personas,
      fecha,
      hora
    })
  });

  const data = await res.json();
  alert(data.message);
  if (data.status === "success") {
    cargarReservas(session.id);
  }
});

// 🔹 Función para mostrar reservas del usuario
async function cargarReservas(user_id) {
  const res = await fetch(http://127.0.0.1:5000/mis_reservas/${user_id});
  const data = await res.json();

  if (data.status === "success") {
    const div = document.getElementById("misReservas");
    div.innerHTML = "<h3>Mis Reservas</h3>";
    data.reservas.forEach(r => {
      div.innerHTML += `
        <div class="card">
          <p><b>Tipo:</b> ${r.tipo}</p>
          <p><b>Personas:</b> ${r.personas}</p>
          <p><b>Fecha:</b> ${r.fecha}</p>
          <p><b>Hora:</b> ${r.hora}</p>
        </div>
      `;
    });
  }
}
